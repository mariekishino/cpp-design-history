
Begin
    Class Worker;
    Begin
        OutText("Worker: Step 1");
        OutImage;

        Detach;

        OutText("Worker: Step 2");
        OutImage;
    End;

    Ref(Worker) A;

    OutText("Main: Before New");
    OutImage;

    A :- New Worker;

    OutText("Main: After New");
    OutImage;

    Resume(A);

    OutText("Main: After Resume");
    OutImage;
End;


